<?xml version="1.0" encoding="UTF-8"?>
<plugin
  xmlns="http://apache.org/cordova/ns/plugins/1.0"
  id="cordova-plugin-screen-orientation-helper"
  version="1.0.0"
>
  <name>Screen Orientation</name>
  <description>Cordova Screen Orientation plugin</description>
  <license>Apache 2.0</license>
  <engines>
    <engine name="cordova" version="&gt;=3.0.0" />
  </engines>
  <js-module src="www/ScreenOrientation.js" name="screenOrientation">
    <clobbers target="cordova.plugins.screenOrientation" />
    <merges target="screen.orientation" />
  </js-module>
  <platform name="ios">
    <config-file target="config.xml" parent="/*">
      <feature name="ScreenOrientation">
        <param name="ios-package" value="ScreenOrientation" />
      </feature>
    </config-file>
    <header-file src="src/ios/ScreenOrientation.h" />
    <source-file src="src/ios/ScreenOrientation.m" />
  </platform>
  <platform name="android">
    <source-file
      src="src/android/ScreenOrientation.java"
      target-dir="src/com/okanbeydanol/screenOrientation/"
    />
    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="ScreenOrientation">
        <param
          name="android-package"
          value="com.okanbeydanol.screenOrientation.ScreenOrientation"
        />
      </feature>
    </config-file>
    <dependency id="es6-promise-plugin" version="^4.1.0" />
  </platform>
</plugin>
